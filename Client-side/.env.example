# Submittly — Frontend environment
#
# Copy to `.env.local` and fill in. `.env.local` is git-ignored; never commit
# real credentials. Every variable below is server-only unless it is prefixed
# with NEXT_PUBLIC_ — and there are currently no NEXT_PUBLIC_ variables.

# Base URL of the Submittly Express API.
# Read only by the proxy route at src/app/api/backend/[...path]/route.ts.
# Local dev: the server runs on port 4000 (see Server-side/.env.example).
API_URL=http://localhost:4000
