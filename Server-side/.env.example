# ───── Server ────────────────────────────────────────────────────────────────
PORT=4000
# development | test | production
NODE_ENV=development

# ───── Database (PostgreSQL) ─────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/submittly?schema=public

# ───── Auth ──────────────────────────────────────────────────────────────────
# Minimum 32 characters (enforced at boot)
JWT_SECRET=replace_me_with_a_random_secret_at_least_32_chars_long
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ───── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000

# ───── Rate limiting ─────────────────────────────────────────────────────────
# Attempts per 15-minute window
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_SUBMIT_MAX=5

# ───── Seed admin (used by `npm run prisma:seed`) ────────────────────────────
# Quote values containing '#' — dotenv treats an unquoted '#' as a comment start.
ADMIN_EMAIL=admin@submittly.dev
ADMIN_PASSWORD="ChangeMe#2026"
