{
  "compilerOptions": {
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // `@/x` -> `src/x`. Resolved relative to this file, so no `baseUrl` is needed.
    // `tsc` leaves these untouched; `tsc-alias` rewrites them at build time.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"],
  // ESM output needs explicit extensions at runtime, so tsc-alias must resolve
  // full paths (`@/app` -> `./app.js`), not just the alias prefix.
  "tsc-alias": {
    "resolveFullPaths": true
  }
}
